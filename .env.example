# ─────────────────────────────────────────────────────────────
# GenAI Data Assistant – Environment Variables (example)
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to version control.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL / pgvector ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=genai_db
DB_USER=postgres
DB_PASSWORD=postgres

# ── Ollama (Local LLM + Embeddings) ─────────────────────────
# When running everything locally:        http://localhost:11434
# When running the API inside Docker:     http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Auth / JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── App defaults ────────────────────────────────────────────
DEFAULT_TOKENS=100
